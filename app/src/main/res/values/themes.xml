<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zujaj" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <!-- native launch screen (Android 12+ system splash, back-ported): logo on the brand background, then straight into the app -->
    <style name="Theme.Zujaj.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fg</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Zujaj</item>
    </style>
    <color name="bg">#FF0A0A0E</color>
    <color name="ic_bg">#FF0E0E14</color>
    <color name="ic_bg_violet">#FF3B2E8F</color>
    <color name="ic_bg_gold">#FFB8862B</color>
    <color name="ic_bg_light">#FFF4F1EA</color>
    <color name="ic_bg_mint">#FF0E6F5C</color>
    <color name="ic_bg_rose">#FF8E2A50</color>
</resources>
