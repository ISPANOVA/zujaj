rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'hegazi.creator@gmail.com';
    }
    // Everyone can read catalog flags (pro/free/new/hidden status)
    match /app/catalog {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Pop-up announcement written in the control panel
    match /app/popup {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Redeem codes: anyone can look up one code by name; only the admin can list/create/delete.
    // A phone may only add 1 to "uses" while creating its own redemption record in the same transaction.
    match /codes/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.active == true
        && (resource.data.expiresAt == 0 || request.time.toMillis() < resource.data.expiresAt)
        && (resource.data.maxUses == 0 || resource.data.uses < resource.data.maxUses)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses', 'lastDevice'])
        && request.resource.data.uses == resource.data.uses + 1
        && request.resource.data.lastDevice is string
        && !exists(/databases/$(database)/documents/codes/$(code)/redemptions/$(request.resource.data.lastDevice))
        && existsAfter(/databases/$(database)/documents/codes/$(code)/redemptions/$(request.resource.data.lastDevice))
      );
      match /redemptions/{dev} {
        allow get: if true;
        allow list, update, delete: if isAdmin();
        allow create: if getAfter(/databases/$(database)/documents/codes/$(code)).data.lastDevice == dev
          && getAfter(/databases/$(database)/documents/codes/$(code)).data.uses == get(/databases/$(database)/documents/codes/$(code)).data.uses + 1;
      }
    }
    // Community gallery: anyone may submit a pending design; only approved ones are public;
    // a like may only add exactly 1; the admin approves and deletes.
    match /gallery/{id} {
      allow get, list: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.likes == 0
        && request.resource.data.keys().hasOnly(['code', 'styleId', 'title', 'status', 'likes', 'createdAt'])
        && request.resource.data.code is string && request.resource.data.code.size() < 6000
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.styleId is string && request.resource.data.styleId.size() < 60;
      allow update: if isAdmin() || (
        resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes == resource.data.likes + 1
      );
      allow delete: if isAdmin();
    }
    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
